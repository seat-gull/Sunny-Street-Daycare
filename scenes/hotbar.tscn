[ext_resource type="Texture2D" uid="uid://bbplyf3ehhuc4" path="res://assets/hotbar slots.webp" id="1_yj1xu"]

[sub_resource type="GDScript" id="GDScript_yj1xu"]
script/source = "extends Control

@export var pencilIcon: Texture2D

signal slotSelected(slotNumber)

var selectedSlot: int = 1

@onready var slots = [$\"HBoxContainer/slot 1\", $\"HBoxContainer/slot 2\", $\"HBoxContainer/slot 3\"]
@onready var itemIcons = [$\"HBoxContainer/slot 1/item icon\", $\"HBoxContainer/slot 2/item icon\", $\"HBoxContainer/slot 3/item icon\"]

func _ready() -> void:
	itemIcons[0].texture = pencilIcon
	for i in range(len(slots)):
		slots[i].gui_input.connect(_on_slot_clicked.bind(i + 1))
		
	update_hotbar()

func _input(event: InputEvent) -> void:
	if event.is_action_pressed(\"slot1\"):
		select_slot(1)
	elif event.is_action_pressed(\"slot2\"):
		select_slot(2)
	elif event.is_action_pressed(\"slot3\"):
		select_slot(3)

func _on_slot_clicked(event: InputEvent, slotNumber: int):
	if event is InputEventMouseButton:
		if event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
			select_slot(slotNumber)

func select_slot(slotNumber):
	selectedSlot = slotNumber
	slotSelected.emit(slotNumber)
	update_hotbar()

func update_hotbar(): 
	for i in range(len(slots)):
		if i + 1 == selectedSlot: 
			slots[i].modulate = Color(1.3, 1.3, 1.3)
		else:
			slots[i].modulate = Color.WHITE
	
"

