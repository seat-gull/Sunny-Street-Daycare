[gd_scene format=3 uid="uid://b2mg5y6fdl640"]

[ext_resource type="Texture2D" uid="uid://b1yq8sngh41ou" path="res://assets/goldkey.png" id="1_hcw3d"]

[sub_resource type="GDScript" id="GDScript_1vivr"]
script/source = "extends Area2D
@export var textbox: CanvasLayer

func _ready() -> void:
	body_entered.connect(pickup)

func pickup(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		if body.hasGoldKey == false:
			var slot = body.hotbar.addItem(\"goldkey\")
			if slot:
				body.hasGoldKey = true
				body._on_slot_selected(2)
				visible = false
				textbox.animate_text(\"You got a gold key!\",\"n\")
				await get_tree().create_timer(3).timeout
				textbox.hide_textbox()
				queue_free()
"

