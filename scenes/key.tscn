[gd_scene format=3 uid="uid://dqxf00fjysulc"]

[ext_resource type="Texture2D" uid="uid://bhbocerojhlgl" path="res://assets/red key black outline.png" id="1_yk2u2"]

[sub_resource type="GDScript" id="GDScript_1vivr"]
script/source = "extends Area2D
@export var textbox: CanvasLayer

func _ready() -> void:
	body_entered.connect(pickup)
	
func pickup(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		if body.key_is_in_inv == false:
			textbox.animate_text(\"You got a red key!\",\"n\")
			body.key_is_in_inv = true
			visible = false
			await get_tree().create_timer(3).timeout
			textbox.hide_textbox()
			queue_free()
			
"

