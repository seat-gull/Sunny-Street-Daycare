[sub_resource type="GDScript" id="GDScript_dinhu"]
script/source = "extends AnimatableBody2D

const bullet_scene = preload(\"res://scenes/mbullet.tscn\")
@export var bullet_textures: Array[Texture2D] = []

@export var textbox: CanvasLayer
@export var player: CharacterBody2D
@onready var sprite = $animation
@onready var shoot_timer = $ShootTimer
@onready var rotater = $rotater
@onready var trigger_area: Area2D = $TriggerArea
@onready var goldkey = $goldkey
@onready var healthbar = $HealthBar

const shooter_timer_wait_time: float = 0.5
const rotate_speed: int = 100
const spawn_point_count: int = 5
const radius: int = 55
const move_speed = 25

var has_triggered: bool = false

var maxhealth = 111
var health = 111
var isDead = false

func _ready() -> void:
	var step = 2 * PI / spawn_point_count
	
	for i in range(spawn_point_count):
		var spawn_point = Node2D.new()
		var pos = Vector2(radius,0).rotated(step*i)
		spawn_point.position = pos
		spawn_point.rotation = pos.angle()
		rotater.add_child(spawn_point)
	
	shoot_timer.stop()
	shoot_timer.wait_time = shooter_timer_wait_time
	
	goldkey.textbox = textbox
	goldkey.monitoring = false
	goldkey.hide()

	trigger_area.body_entered.connect(_on_player_entered)
	healthbar.init_health(maxhealth)

func _process(delta: float) -> void:
	rotater.rotation_degrees += rotate_speed * delta
	
	if has_triggered and !isDead:
		sprite.look_at(player.global_position)
		sprite.rotation += PI/2
		
		var direction = global_position.direction_to(player.global_position)
		move_and_collide(direction * move_speed * delta)

#detect player enter boss area
func _on_player_entered(body: Node2D) -> void:
	if has_triggered or not body.is_in_group(\"player\"):
		return

	has_triggered = true
	trigger_area.set_deferred(\"monitoring\", false)
	body.movement_locked = true
	textbox.animate_text(\"So you murdered Blobby? I'll kill you!\", \"Malgretta\")
	await get_tree().create_timer(3).timeout
	textbox.hide_textbox()
	
	if is_instance_valid(body):
		body.movement_locked = false
	shoot_timer.start()

func _on_shoot_timer_timeout() -> void:
	for s in rotater.get_children():
		var bullet = bullet_scene.instantiate()
		get_tree().current_scene.add_child(bullet)
		bullet.position = s.global_position
		bullet.rotation = s.global_rotation
			
		var texture = bullet_textures.pick_random()
		bullet.set_bullet_texture(texture)

func takeDamage(amount: int) -> void:
	health = max(health - amount, 0)
	healthbar._set_health(health)
	
	if health <= 0:
		die()
	
func die() -> void:
	if isDead:
		return
		
	isDead = true
	shoot_timer.stop()
	
	textbox.animate_text(\"NOOOoooo!\", \"Malgretta\")
	sprite.global_rotation = 0
	sprite.play(\"dying\")
	await sprite.animation_finished
	remove_child(goldkey)
	textbox.hide_textbox()
	get_tree().current_scene.add_child(goldkey)
	goldkey.global_position = Vector2(global_position.x+6,global_position.y)
	
	goldkey.show()
	goldkey.set_deferred(\"monitoring\", true)
	healthbar.hide()
	collision_layer = false
"

